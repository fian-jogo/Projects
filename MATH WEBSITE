<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Materi Matematika SMP–SMA Lengkap</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Lora:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --bg: #0f1117;
    --bg2: #161b27;
    --bg3: #1e2538;
    --surface: #252d42;
    --surface2: #2e3a55;
    --border: #334166;
    --accent: #4f9cf9;
    --accent2: #7b61ff;
    --accent3: #f97316;
    --accent4: #10b981;
    --accent5: #f43f5e;
    --text: #e2e8f0;
    --text2: #94a3b8;
    --text3: #64748b;
    --yellow: #fbbf24;
    --card-a: #1a2540;
    --card-b: #1a2032;
    --card-c: #1d2430;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    min-height: 100vh;
  }

  /* SIDEBAR */
  #sidebar {
    position: fixed;
    left: 0; top: 0; bottom: 0;
    width: 280px;
    background: var(--bg2);
    border-right: 1px solid var(--border);
    overflow-y: auto;
    z-index: 100;
    transition: transform 0.3s ease;
  }
  #sidebar::-webkit-scrollbar { width: 4px; }
  #sidebar::-webkit-scrollbar-track { background: transparent; }
  #sidebar::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

  .sidebar-header {
    padding: 20px 20px 16px;
    border-bottom: 1px solid var(--border);
    position: sticky; top: 0;
    background: var(--bg2);
    z-index: 1;
  }
  .sidebar-header h1 {
    font-family: 'Lora', serif;
    font-size: 16px;
    font-weight: 600;
    color: var(--accent);
    line-height: 1.3;
  }
  .sidebar-header p {
    font-size: 11px;
    color: var(--text3);
    margin-top: 4px;
  }

  .nav-section {
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
  }
  .nav-section-label {
    padding: 10px 20px 4px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text3);
  }
  .nav-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 20px;
    font-size: 13px;
    color: var(--text2);
    text-decoration: none;
    transition: all 0.15s;
    border-left: 2px solid transparent;
  }
  .nav-link:hover {
    color: var(--text);
    background: var(--bg3);
    border-left-color: var(--accent);
  }
  .nav-link.active {
    color: var(--accent);
    background: rgba(79,156,249,0.08);
    border-left-color: var(--accent);
  }
  .nav-link .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--text3);
  }
  .nav-link:hover .dot, .nav-link.active .dot { background: var(--accent); }

  /* MAIN */
  #main {
    margin-left: 280px;
    min-height: 100vh;
  }

  .top-bar {
    background: var(--bg2);
    border-bottom: 1px solid var(--border);
    padding: 0 40px;
    height: 56px;
    display: flex;
    align-items: center;
    gap: 16px;
    position: sticky; top: 0;
    z-index: 50;
  }
  .hamburger {
    display: none;
    background: none; border: none;
    cursor: pointer; color: var(--text2);
    font-size: 20px;
  }
  .breadcrumb { font-size: 13px; color: var(--text3); }
  .breadcrumb span { color: var(--text2); }

  .content {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 40px 80px;
  }

  /* HERO */
  .hero {
    text-align: center;
    padding: 60px 20px 40px;
    margin-bottom: 10px;
  }
  .hero-badge {
    display: inline-block;
    background: rgba(79,156,249,0.12);
    border: 1px solid rgba(79,156,249,0.3);
    color: var(--accent);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 14px;
    border-radius: 20px;
    margin-bottom: 20px;
  }
  .hero h1 {
    font-family: 'Lora', serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 16px;
    background: linear-gradient(135deg, #e2e8f0 0%, #94a3b8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero p {
    font-size: 16px;
    color: var(--text2);
    max-width: 600px;
    margin: 0 auto 28px;
  }
  .hero-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }
  .pill {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text2);
    font-size: 12px;
    padding: 4px 12px;
    border-radius: 20px;
  }

  /* CHAPTER HEADING */
  .chapter {
    scroll-margin-top: 70px;
    margin-bottom: 60px;
  }
  .chapter-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }
  .chapter-icon {
    width: 52px; height: 52px;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 24px;
    flex-shrink: 0;
  }
  .chapter-icon.a { background: rgba(79,156,249,0.15); }
  .chapter-icon.b { background: rgba(123,97,255,0.15); }
  .chapter-icon.c { background: rgba(16,185,129,0.15); }
  .chapter-icon.d { background: rgba(249,115,22,0.15); }
  .chapter-icon.e { background: rgba(244,63,94,0.15); }
  .chapter-icon.f { background: rgba(251,191,36,0.15); }
  .chapter-icon.g { background: rgba(79,156,249,0.15); }
  .chapter-icon.h { background: rgba(16,185,129,0.15); }
  .chapter-icon.i { background: rgba(123,97,255,0.15); }
  .chapter-title { flex: 1; }
  .chapter-title h2 {
    font-family: 'Lora', serif;
    font-size: 22px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 4px;
  }
  .chapter-title p { font-size: 13px; color: var(--text3); }

  /* TOPIC */
  .topic {
    scroll-margin-top: 70px;
    margin-bottom: 40px;
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }
  .topic-header {
    padding: 18px 24px;
    background: var(--bg3);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    user-select: none;
  }
  .topic-num {
    background: var(--accent);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    width: 26px; height: 26px;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .topic-header h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    flex: 1;
  }
  .topic-toggle {
    color: var(--text3);
    font-size: 18px;
    transition: transform 0.25s;
  }
  .topic.open .topic-toggle { transform: rotate(180deg); }
  .topic-body {
    display: none;
    padding: 24px;
  }
  .topic.open .topic-body { display: block; }

  /* CONTENT STYLES */
  .section-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 24px 0 10px;
  }
  .section-title:first-child { margin-top: 0; }

  p { margin-bottom: 12px; color: var(--text2); }
  p:last-child { margin-bottom: 0; }
  p strong { color: var(--text); }

  ul, ol {
    padding-left: 20px;
    color: var(--text2);
    margin-bottom: 12px;
  }
  li { margin-bottom: 6px; }
  li strong { color: var(--text); }

  /* FORMULA BOX */
  .formula-box {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 10px;
    padding: 16px 20px;
    margin: 16px 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    color: var(--yellow);
    line-height: 1.8;
  }
  .formula-box.green { border-left-color: var(--accent4); color: #6ee7b7; }
  .formula-box.purple { border-left-color: var(--accent2); color: #c4b5fd; }
  .formula-box.orange { border-left-color: var(--accent3); color: #fdba74; }
  .formula-box.red { border-left-color: var(--accent5); color: #fda4af; }

  /* CONCEPT BOX */
  .concept-box {
    background: rgba(79,156,249,0.06);
    border: 1px solid rgba(79,156,249,0.2);
    border-radius: 10px;
    padding: 16px 20px;
    margin: 16px 0;
  }
  .concept-box .label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .concept-box.yellow { background: rgba(251,191,36,0.06); border-color: rgba(251,191,36,0.2); }
  .concept-box.yellow .label { color: var(--yellow); }
  .concept-box.green { background: rgba(16,185,129,0.06); border-color: rgba(16,185,129,0.2); }
  .concept-box.green .label { color: var(--accent4); }
  .concept-box.red { background: rgba(244,63,94,0.06); border-color: rgba(244,63,94,0.2); }
  .concept-box.red .label { color: var(--accent5); }

  /* EXAMPLE */
  .example {
    background: var(--surface);
    border-radius: 12px;
    margin: 20px 0;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .example-header {
    background: var(--surface2);
    padding: 10px 18px;
    font-size: 12px;
    font-weight: 600;
    color: var(--yellow);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .example-header::before {
    content: '✦';
    font-size: 10px;
  }
  .example-body { padding: 18px; }
  .example-body .question {
    color: var(--text);
    font-weight: 500;
    margin-bottom: 14px;
    font-size: 15px;
  }
  .example-body .step {
    display: flex;
    gap: 12px;
    margin-bottom: 10px;
    align-items: flex-start;
  }
  .step-num {
    width: 22px; height: 22px;
    background: var(--accent);
    color: #fff;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .step-text { color: var(--text2); flex: 1; }
  .step-text code {
    font-family: 'JetBrains Mono', monospace;
    background: var(--bg3);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 13px;
    color: var(--yellow);
  }
  .answer-box {
    margin-top: 14px;
    background: rgba(16,185,129,0.1);
    border: 1px solid rgba(16,185,129,0.25);
    border-radius: 8px;
    padding: 12px 16px;
    color: #6ee7b7;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
  }
  .answer-box::before {
    content: '✓ Jawaban: ';
    font-weight: 700;
    font-family: 'Inter', sans-serif;
  }

  /* TABLE */
  .math-table {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0;
    font-size: 14px;
  }
  .math-table th {
    background: var(--surface2);
    color: var(--text);
    padding: 10px 14px;
    text-align: center;
    font-weight: 600;
    border: 1px solid var(--border);
  }
  .math-table td {
    padding: 8px 14px;
    border: 1px solid var(--border);
    color: var(--text2);
    text-align: center;
  }
  .math-table tr:nth-child(even) td { background: rgba(255,255,255,0.02); }
  .math-table td strong { color: var(--yellow); }

  /* GRID */
  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 16px 0;
  }
  .grid-3 {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 12px;
    margin: 16px 0;
  }
  .mini-card {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
  }
  .mini-card .title {
    font-size: 12px;
    font-weight: 600;
    color: var(--text3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }
  .mini-card .val {
    font-family: 'JetBrains Mono', monospace;
    font-size: 15px;
    color: var(--yellow);
  }

  /* DIVIDER */
  .divider { height: 1px; background: var(--border); margin: 32px 0; }

  /* SCROLL TO TOP */
  #scrollTop {
    position: fixed;
    bottom: 30px; right: 30px;
    width: 44px; height: 44px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    font-size: 20px;
    display: none;
    align-items: center; justify-content: center;
    z-index: 200;
    box-shadow: 0 4px 16px rgba(79,156,249,0.4);
    transition: transform 0.2s;
  }
  #scrollTop:hover { transform: scale(1.1); }
  #scrollTop.show { display: flex; }

  /* PROGRESS */
  #progress {
    position: fixed;
    top: 0; left: 280px; right: 0;
    height: 2px;
    background: var(--border);
    z-index: 101;
  }
  #progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    width: 0%;
    transition: width 0.1s;
  }

  /* SUB LIST */
  .sub-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 10px 0;
  }
  .sub-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--text2);
    font-size: 14px;
    margin: 0;
  }
  .sub-list li::before {
    content: '→';
    color: var(--accent);
    font-size: 12px;
    margin-top: 2px;
    flex-shrink: 0;
  }

  code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    background: var(--bg3);
    padding: 1px 6px;
    border-radius: 4px;
    color: var(--yellow);
  }

  /* ANALOGY */
  .analogy {
    background: rgba(251,191,36,0.05);
    border-left: 3px solid var(--yellow);
    padding: 12px 16px;
    border-radius: 0 8px 8px 0;
    margin: 12px 0;
    font-size: 14px;
    color: var(--text2);
  }
  .analogy strong { color: var(--yellow); }

  @media (max-width: 768px) {
    #sidebar { transform: translateX(-100%); }
    #sidebar.open { transform: translateX(0); }
    #main { margin-left: 0; }
    #progress { left: 0; }
    .hamburger { display: block; }
    .content { padding: 24px 16px 60px; }
    .grid-2, .grid-3 { grid-template-columns: 1fr; }
    .top-bar { padding: 0 16px; }
  }

  /* Overlay for mobile */
  #overlay {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 99;
  }
  #overlay.show { display: block; }
</style>
</head>
